# Copy this file to .env.local and fill in your Supabase project's values
# (Settings -> API in the Supabase dashboard).
#
# VITE_SUPABASE_ANON_KEY is the publishable/anon key — safe to ship in
# frontend code, Row Level Security is what actually protects the data.
# Never put the service_role/secret key in a Vite env var.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
